# Google ADK requires either Vertex AI credentials or an API key
GOOGLE_API_KEY=your_api_key_here
# Or set Vertex AI:
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Optional: where generated scripts go
SCRAPER_OUTPUT_DIR=./generated_scrapers
